# ===================================================
# FleetOps AI - Environment Configuration
# ===================================================

# Application
APP_NAME="FleetOps AI"
ENVIRONMENT="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# CORS Whitelist (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://fleetops.yourdomain.com"

# Database Configuration (PostgreSQL / PostGIS in Production)
# DATABASE_URL="postgresql://fleetops:fleetops_secure_password@postgres:5432/fleetops"
DATABASE_URL="sqlite:///./fleetops.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache & Pub/Sub
REDIS_URL="redis://redis:6379/0"
REDIS_ENABLED=false

# Authentication & Security
AUTH_REQUIRED=false
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Observability
PROMETHEUS_ENABLED=true
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true
